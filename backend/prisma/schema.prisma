generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Customer information
model Customer {
  id        String   @id @default(cuid())
  fullName  String
  email     String   @unique
  createdAt DateTime @default(now())

  accounts Account[]
}

// Bank accounts
// customerId is optional because ZBL also has bank-owned accounts.
model Account {
  id            String   @id @default(cuid())
  accountNumber String   @unique
  balance       Decimal  @default(0) @db.Decimal(18, 2)
  isActive      Boolean  @default(true)
  customerId    String?
  createdAt     DateTime @default(now())

  customer Customer? @relation(fields: [customerId], references: [id])

  sentTransactions     BankTransaction[] @relation("SourceAccount")
  receivedTransactions BankTransaction[] @relation("DestinationAccount")

  ledgerEntries LedgerEntry[]
}

// Records money movements between accounts
model BankTransaction {
  id                   String            @id @default(cuid())
  reference            String            @unique
  type                 TransactionType
  amount               Decimal           @db.Decimal(18, 2)
  status               TransactionStatus @default(PENDING)
  sourceAccountId      String
  destinationAccountId String
  createdAt            DateTime          @default(now())

  sourceAccount      Account @relation("SourceAccount", fields: [sourceAccountId], references: [id])
  destinationAccount Account @relation("DestinationAccount", fields: [destinationAccountId], references: [id])

  ledgerEntries LedgerEntry[]
}

// Records debit and credit entries
model LedgerEntry {
  id            String          @id @default(cuid())
  transactionId String
  accountId     String
  entryType     LedgerEntryType
  amount        Decimal         @db.Decimal(18, 2)
  createdAt     DateTime        @default(now())

  transaction BankTransaction @relation(fields: [transactionId], references: [id])
  account     Account         @relation(fields: [accountId], references: [id])

  @@index([transactionId])
  @@index([accountId])
}

enum TransactionType {
  DEPOSIT
  TRANSFER
  PAYOUT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum LedgerEntryType {
  DEBIT
  CREDIT
}
